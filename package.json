{
  "name": "askod-reports",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build:windows": "npm run build && tsx scripts/package-desktop.ts windows",
    "build:ubuntu": "npm run build && tsx scripts/package-desktop.ts ubuntu",
    "build:mac": "npm run build && tsx scripts/package-desktop.ts mac",
    "dev": "npm run db:generate && npm run dev -w @askod/desktop",
    "dev:backend": "npm run db:generate && npm run dev -w @askod/backend",
    "build": "npm run db:generate && npm run typecheck && npm run build -w @askod/desktop && npm run build -w @askod/backend",
    "preview": "npm run preview -w @askod/desktop",
    "start:backend": "npm run start -w @askod/backend",
    "db:generate": "npm run db:generate -w @askod/backend",
    "typecheck": "tsc --noEmit && npm run typecheck -w @askod/backend",
    "test": "vitest run",
    "postinstall": "npm run db:generate && node node_modules/electron/install.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:desktop": "playwright test --config apps/desktop/playwright.config.ts --grep @smoke",
    "test:e2e": "playwright test --config apps/desktop/playwright.config.ts",
    "test:e2e:report": "playwright show-report .data/e2e/report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
