generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id                 String   @id @default(uuid())
  registrationNumber String
  title              String
  registeredAt       DateTime

  @@index([registeredAt])
  @@index([registrationNumber])
}
